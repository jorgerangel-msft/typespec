<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputPath>..\dist\generator\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\http-client-csharp\generator\Microsoft.TypeSpec.Generator\src\Microsoft.TypeSpec.Generator.csproj" />
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.4" />
    <PackageReference Include="Google.Protobuf" Version="3.30.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.70.0" />
    <PackageReference Include="Grpc.Tools" Version="2.71.0" PrivateAssets="all" />
    <Protobuf Include="assets\upstream\proto\*.proto" ProtoRoot="assets\upstream\proto" GrpcServices="Both" />
    <EmbeddedResource Include="assets\**\*" />
  </ItemGroup>
  <Target Name="CopyGeneratorHost" AfterTargets="Build">
    <ItemGroup>
      <GeneratorHostFiles Include="..\..\http-client-csharp\generator\artifacts\bin\Microsoft.TypeSpec.Generator\$(Configuration)\net10.0\Microsoft.TypeSpec.Generator.runtimeconfig.json" />
      <GeneratorHostFiles Include="..\..\http-client-csharp\generator\artifacts\bin\Microsoft.TypeSpec.Generator\$(Configuration)\net10.0\Microsoft.TypeSpec.Generator.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(GeneratorHostFiles)" DestinationFolder="$(TargetDir)" />
  </Target>
</Project>
